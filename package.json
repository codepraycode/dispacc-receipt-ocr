{
    "name": "@dispacc/receipt-ocr",
    "version": "1.0.0",
    "description": "AI‑powered receipt OCR for Nigerian fintech transactions (Opay, PalmPay, Kuda, etc.) – extracts structured data from images",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "lint": "eslint src/",
        "format": "prettier --write .",
        "prepublishOnly": "npm run build",
        "version:patch": "npm version patch -m \"chore: release v%s\"",
        "version:minor": "npm version minor -m \"chore: release v%s\"",
        "version:major": "npm version major -m \"chore: release v%s\"",
        "pub": "npm publish --access public",
        "release:patch": "npm run version:patch && git push && git push --tags && npm run pub",
        "release:minor": "npm run version:minor && git push && git push --tags && npm run pub",
        "release:major": "npm run version:major && git push && git push --tags && npm run pub"
    },
    "peerDependencies": {
        "groq-sdk": "^1.1.2"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.20.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.3",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.59.2"
    },
    "keywords": [
        "receipt",
        "ocr",
        "vision",
        "naira",
        "nigeria",
        "fintech",
        "opay",
        "palmpay",
        "kuda",
        "moniepoint",
        "groq",
        "llama",
        "extraction",
        "transaction"
    ],
    "author": "codepraycode",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codepraycode/dispacc-receipt-ocr.git"
    },
    "bugs": {
        "url": "https://github.com/codepraycode/dispacc-receipt-ocr/issues"
    },
    "homepage": "https://github.com/codepraycode/dispacc-receipt-ocr#readme",
    "packageManager": "pnpm@10.18.0"
}
